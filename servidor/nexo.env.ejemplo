# ============================================================================
# NEXO — Configuración del servidor de la escuela
# ----------------------------------------------------------------------------
# Copiá este archivo como "nexo.env" (en esta misma carpeta) y completalo.
# NEXO lo lee al arrancar:   node --env-file=nexo.env servidor.js
# Las rutas se pueden escribir con / o con \. Las líneas con # no cuentan.
# "nexo.env" NO se sube a git (está en .gitignore).
# ============================================================================

# ── Dónde escucha NEXO ──────────────────────────────────────────────────────
# 127.0.0.1 = solo desde esta misma máquina. La puerta de entrada para todos es
# Apache (XAMPP), que recibe el HTTPS y le pasa los pedidos a NEXO.
NEXO_HOST=127.0.0.1
NEXO_PORT=3073

# ── Los datos de la escuela ─────────────────────────────────────────────────
# Afuera de la carpeta del programa: así actualizar NEXO nunca los toca.
NEXO_DB_PATH=C:/nexo-datos/nexo.db
NEXO_STORAGE_DIR=C:/nexo-datos/archivos
# Los respaldos, mejor en OTRO disco (o un disco externo / carpeta de red).
NEXO_RESPALDOS_DIR=C:/nexo-datos/respaldos

# ── Seguridad ───────────────────────────────────────────────────────────────
# Apache sirve NEXO con HTTPS: la cookie de sesión solo viaja cifrada.
# Ponelo en 0 únicamente si (por ahora) entran por http:// sin certificado.
NEXO_COOKIE_SEGURA=1

# ── Notificaciones push (avisos que suenan en el celular) ───────────────────
# El contacto que ven Google, Mozilla y Microsoft si algo falla con los avisos.
NEXO_PUSH_CONTACTO=mailto:sistemas@miescuela.edu.ar

# ── Opcional: tutor con IA en un servidor propio (Ollama) ──────────────────
# Sin esto, el tutor usa Ollama en esta misma máquina si está instalado.
# NEXO_IA_URL=http://192.168.0.50:11434
# NEXO_IA_MODELO=llama3.2

# ── Opcional: videollamadas del aula virtual ────────────────────────────────
# Máximo de cámaras por clase (por defecto 12).
# NEXO_MAX_VIDEO=12
